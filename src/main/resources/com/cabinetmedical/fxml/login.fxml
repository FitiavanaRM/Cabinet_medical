<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cabinetmedical.controller.LoginController">

    <center>
        <VBox spacing="15" style="-fx-padding: 25;" alignment="CENTER">
            <Label text="Connexion au cabinet medical" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <GridPane hgap="10" vgap="10">
                <padding>
                    <Insets top="10" bottom="10" left="10" right="10"/>
                </padding>
                <Label text="Login :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="champLogin" promptText="Login" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Mot de passe :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="champMotDePasse" promptText="Mot de passe" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>
            <Button text="Se connecter" onAction="#onConnexion" maxWidth="200"/>
        </VBox>
    </center>

</BorderPane>
