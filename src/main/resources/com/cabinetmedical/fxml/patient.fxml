<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:id="rootPane"
           fx:controller="com.cabinetmedical.controller.PatientController"
           stylesheets="@../css/style.css">
    <children>
        <BorderPane>
            <top>
                <HBox spacing="10" style="-fx-padding: 10;">
                    <Button text="Retour" onAction="#onRetour"/>
                    <Label text="Gestion des Patients" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                </HBox>
            </top>

            <center>
                <TableView fx:id="tablePatients">
                    <columns>
                        <TableColumn fx:id="colId" text="Id" prefWidth="40"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="100"/>
                        <TableColumn fx:id="colPrenom" text="Prenom" prefWidth="100"/>
                        <TableColumn fx:id="colDateNaissance" text="Date de naissance" prefWidth="130"/>
                        <TableColumn fx:id="colTelephone" text="Telephone" prefWidth="110"/>
                    </columns>
                </TableView>
            </center>

            <right>
                <VBox spacing="8" prefWidth="260">
                    <padding>
                        <Insets top="10" bottom="10" left="10" right="10"/>
                    </padding>

                    <Label text="Nom"/>
                    <TextField fx:id="champNom"/>

                    <Label text="Prenom"/>
                    <TextField fx:id="champPrenom"/>

                    <Label text="Date de naissance"/>
                    <DatePicker fx:id="champDateNaissance" maxWidth="Infinity"/>

                    <Label text="Telephone"/>
                    <TextField fx:id="champTelephone"/>

                    <Label text="Adresse"/>
                    <TextField fx:id="champAdresse"/>

                    <Label text="Antecedents"/>
                    <TextArea fx:id="champAntecedents" prefRowCount="3"/>

                    <Button text="Nouveau" onAction="#onNouveau" maxWidth="Infinity"/>
                    <Button text="Ajouter" onAction="#onAjouter" maxWidth="Infinity"/>
                    <Button text="Modifier" onAction="#onModifier" maxWidth="Infinity"/>
                    <Button text="Supprimer" onAction="#onSupprimer" maxWidth="Infinity"/>

                </VBox>
            </right>
        </BorderPane>
    </children>
</StackPane>